      "parameters": {
        "jsCode": "// n8n Function node\n// Extracts video URL from string like:\n// event: complete\\ndata: [{...}]\\n\\n\n\nconst input =  $input.first().json;\n\n// If your input is like { data: \"...\" }\nconst rawString = input.data || input;\n\n// Extract everything AFTER 'data: '\nconst dataStart = rawString.indexOf('data: ');\nif (dataStart === -1) {\n  throw new Error('No `data:` found in input string');\n}\n\n// Get the JSON substring\nconst jsonStringPart = rawString.substring(dataStart + 6);\n\n// Remove trailing escaped \\n\\n if present\nconst cleanedJsonString = jsonStringPart.replace(/\\\\n\\\\n$/, '');\n\n// Now parse JSON\nlet parsedArray;\ntry {\n  parsedArray = JSON.parse(cleanedJsonString);\n} catch (err) {\n  throw new Error('Could not parse JSON: ' + err.message);\n}\n\n// Grab the URL\nconst videoUrl = parsedArray[0].video.url;\n\nreturn [\n  {\n    json: {\n      videoUrl: videoUrl,\n    },\n  },\n];\n"
      },
