  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "send-recommendation",
        "responseMode": "responseNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        -288,
        304
      ],
      "id": "16e01f91-f15d-49cf-8c29-10ccc42ae15a",
      "name": "Webhook",
      "webhookId": "send-recommendation"
    },
    {
      "parameters": {
        "jsCode": "const body = $('Webhook').first().json.body;\n\nconst PLAN_CHANNELS = {\n  midcap_wealth:  '-1003556619522',\n  smallcap_alpha: '-1003457667360',\n  sme_emerging:   '-1003841397664',\n};\n\nconst {\n  company_name, nse_symbol, rating, cmp, target_price,\n  upside_pct, validity_type, validity_date, plans,\n  trade_notes, report_file_url, pdf_file_id, session_id\n} = body;\n\nlet validityText;\nif (validity_type === 'custom' && validity_date) {\n  validityText = new Date(validity_date).toLocaleDateString('en-IN', {\n    day: '2-digit', month: 'short', year: 'numeric'\n  });\n} else {\n  const expiry = new Date();\n  expiry.setFullYear(expiry.getFullYear() + 1);\n  validityText = expiry.toLocaleDateString('en-IN', {\n    day: '2-digit', month: 'short', year: 'numeric'\n  });\n}\n\nconst ratingEmoji = rating === 'BUY' ? '🟢' : '🔴';\nconst upsideText = upside_pct != null\n  ? ` <b>(${upside_pct > 0 ? '+' : ''}${upside_pct}% upside)</b>`\n  : '';\n\nlet message = `${ratingEmoji} <b>${rating} — ${company_name}</b>\\n`;\nmessage += `<code>NSE: ${nse_symbol}</code>\\n\\n`;\nmessage += `💰 <b>CMP:</b> ₹${cmp ? Number(cmp).toLocaleString('en-IN') : 'N/A'}\\n`;\nmessage += `🎯 <b>Target:</b> ₹${Number(target_price).toLocaleString('en-IN')}${upsideText}\\n`;\nmessage += `📅 <b>Valid till:</b> ${validityText}\\n`;\n\nif (trade_notes) {\n  message += `\\n📝 <b>Notes:</b>\\n${trade_notes}\\n`;\n}\n\n// === Secure In-App Viewer Link using Mobile Vercel Domain ===\nif (session_id) {\n  const appRedirectUrl = `https://tikona-mobile.vercel.app/report/${session_id}`;\n  message += `\\n📄 <b>Research Report:</b> <a href=\"${appRedirectUrl}\">View Report</a>\\n`;\n} else if (report_file_url) {\n  message += `\\n📄 <b>Research Report:</b> <a href=\"${report_file_url}\">View Report</a>\\n`;\n}\n\nmessage += `\\n<i>— Tikona Capital Research</i>`;\n\nconst items = [];\nfor (const planId of (plans || [])) {\n  const chatId = PLAN_CHANNELS[planId];\n  if (chatId) {\n    items.push({\n      json: {\n        chat_id: chatId,\n        message,\n        plan: planId,\n        pdf_file_id: pdf_file_id || null,\n        company_name,\n        nse_symbol\n      }\n    });\n  }\n}\n\nif (items.length === 0) {\n  throw new Error('No matching channels for plans: ' + JSON.stringify(plans));\n}\n\nreturn items;\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -48,
        304
      ],
      "id": "e3c69660-97cc-4d9d-8763-39cc05a74496",
