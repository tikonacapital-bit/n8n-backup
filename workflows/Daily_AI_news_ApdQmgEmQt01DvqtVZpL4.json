    },
    {
      "parameters": {
        "jsCode": "const results = [];\nconst fortyEightHoursAgo = new Date(Date.now() - 48 * 60 * 60 * 1000);\n\nfor (const item of $input.all()) {\n  const pubDate = new Date(item.json.isoDate || item.json.pubDate);\n  if (pubDate > fortyEightHoursAgo) {\n    results.push({\n      json: {\n        title: item.json.title,\n        link: item.json.link,\n        snippet: item.json.contentSnippet || item.json.content || 'No content provided.',\n        date: pubDate.toISOString()\n      }\n    });\n  }\n}\nreturn results;"
      },
      "id": "4712ab91-d232-46ef-9721-c3cce1640a8c",
      "name": "Filter 48h & Normalize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1040,
        144
      ]
    },
    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\n\n// We are changing the array name to 'processedUrls_v2' to force a fresh start\nstaticData.processedUrls_v2 = staticData.processedUrls_v2 || [];\n\nconst newItems = [];\nfor (const item of $input.all()) {\n  if (!staticData.processedUrls_v2.includes(item.json.link)) {\n    newItems.push(item);\n    staticData.processedUrls_v2.push(item.json.link);\n  }\n}\n\n// Prevent memory bloat\nif (staticData.processedUrls_v2.length > 500) {\n  staticData.processedUrls_v2 = staticData.processedUrls_v2.slice(-500);\n}\n\nreturn newItems;"
      },
      "id": "477f0b0d-7f8b-4e07-859e-468b50e2a509",
      "name": "Deduplicate (Memory)",
