    },
    {
      "parameters": {
        "resource": "chat",
        "model": "gpt-4",
        "prompt": {
          "messages": [
            {
              "role": "system",
              "content": "You are a specialized AI and tech analyst. Evaluate the following news article on a scale of 1 to 5 based on significance. 5 = Major product launch (OpenAI, Google, Anthropic) or massive acquisition. 4 = High-impact case study, real-world application, or mid-tier investment. 1-3 = Minor UI updates, fluff, opinion pieces, or redundant PR.  Respond ONLY with a valid JSON object matching this schema: {   \"score\": number,   \"category\": \"string (Product Launch, Case Study, Investment, or Other)\",   \"summary\": \"string (1 concise paragraph summarizing why it matters)\",   \"original_title\": \"string (copy exactly from input)\",   \"original_link\": \"string (copy exactly from input)\" }"
            },
            {
              "content": "=Title: {{ $json.title }} Link: {{ $json.link }} Snippet: {{ $json.snippet }}"
            }
          ]
        },
        "simplifyOutput": false,
        "options": {},
        "requestOptions": {}
      },
      "id": "6ca63708-cc30-405f-8b18-0ba50b6acfc2",
      "name": "OpenAI JSON Scorer",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [
        -592,
        144
      ],
      "credentials": {
        "openAiApi": {
          "id": "TMMS3pMqjiGuuWVj",
          "name": "RAG 23-12-2025"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const results = [];\nfor (const item of $input.all()) {\n  try {\n    // This line checks both the \"Simplified\" and \"Raw\" locations for the OpenAI text\n    let rawContent = item.json.message?.content || item.json.choices[0]?.message?.content;\n    \n    const aiResponse = JSON.parse(rawContent);\n    \n    results.push({\n      json: {\n        title: aiResponse.original_title,\n        link: aiResponse.original_link,\n        score: aiResponse.score,\n        category: aiResponse.category,\n        summary: aiResponse.summary\n      }\n    });\n  } catch (e) {\n    // If it fails, it will now pass a helpful error message to the console instead of just failing silently\n    console.log(\"Failed to parse JSON for an item: \", e);\n  }\n}\nreturn results;"
      },
