    {
      "parameters": {
        "jsCode": "// n8n gives: items = [{json: {...}}, {json: {...}}, ...]\nconst data = items.map(item => item.json);\n\nconst firstPart = [];\nconst secondPart = [];\n\nfor (const row of data) {\n  // --- Part 1: Name, BSE Code, NSE Code (A4:C)\n  firstPart.push([\n    row[\"Name\"] || \"\",\n    row[\"BSE Code\"] || \"\",\n    row[\"NSE Code\"] || \"\"\n  ]);\n\n  // --- Part 2: Industry Group + rest (skip Industry, Name, BSE Code, NSE Code)\n  const {\n    \"Industry Group\": industryGroup,\n    \"Industry\": _,\n    \"Name\": __,\n    \"BSE Code\": ___,\n    \"NSE Code\": ____,\n    ...rest\n  } = row;\n\n  // Ensure Industry Group is first\n  const ordered = { \"Industry Group\": industryGroup, ...rest };\n  secondPart.push(Object.values(ordered));\n}\n\n// Return both datasets\nreturn [\n  { json: { valuesAtoC: firstPart } },\n  { json: { valuesEtoBI: secondPart } }\n];\n"
      },
