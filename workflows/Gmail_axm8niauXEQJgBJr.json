      {
        "parameters": {
          "jsCode": "const outputItems = [];\n\nfor (const item of items) {\n  const binaryData = item.binary || {};\n  let pdfFound = false;\n\n  // 1. Check for physical email attachments\n  for (const key in binaryData) {\n    const bin = binaryData[key];\n    if (bin.mimeType === 'application/pdf' || (bin.fileName && bin.fileName.toLowerCase().endsWith('.pdf'))) {\n      pdfFound = true;\n      outputItems.push({\n        json: { \n          hasPDF: true, \n          isLink: false, \n          fileName: bin.fileName || `${key}.pdf`, \n          binaryKey: key \n        },\n        binary: { [key]: bin }\n      });\n    }\n  }\n\n  // 2. If no physical attachment, scan email body/HTML for PDF or download links\n  if (!pdfFound) {\n    let rawBody = item.json.textHtml || item.json.html || item.json.textPlain || item.json.snippet || '';\n    if (typeof rawBody === 'object') {\n      rawBody = JSON.stringify(rawBody);\n    }\n\n    let rawSubject = item.json.Subject || item.json.subject || item.json.snippet || 'No Subject';\n    let safeSubject = String(rawSubject).replace(/[\\/\\\\]/g, ' - ');\n\n    let foundUrl = null;\n\n    // Pattern A: Direct URL containing .pdf (including links with query parameters like .pdf?token=123)\n    const pdfUrlRegex = /(https?:\\/\\/[^\\s\"'<>]+\\.pdf(\\?[^\\s\"'<>]*)?)/i;\n    const pdfMatch = rawBody.match(pdfUrlRegex);\n\n    if (pdfMatch && pdfMatch[1]) {\n      foundUrl = pdfMatch[1];\n    } else {\n      // Pattern B: Look inside HTML <a href=\"...\"> tags\n      const hrefRegex = /<a\\s+(?:[^>]*?\\s+)?href=[\"'](https?:\\/\\/[^\"']+)[\"'][^>]*>(.*?)<\\/a>/gi;\n      let match;\n      while ((match = hrefRegex.exec(rawBody)) !== null) {\n        const url = match[1];\n        const anchorText = match[2].toLowerCase();\n        const urlLower = url.toLowerCase();\n\n        if (\n          urlLower.includes('.pdf') ||\n          urlLower.includes('download') ||\n          anchorText.includes('click here') ||\n          anchorText.includes('pdf') ||\n          anchorText.includes('presentation') ||\n          anchorText.includes('result') ||\n          anchorText.includes('report')\n        ) {\n          foundUrl = url;\n          break;\n        }\n      }\n    }\n\n    if (foundUrl) {\n      // UNWRAP TRACKING LINKS (e.g., awstrack.me, sendgrid, mandrill)\n      const nestedUrlMatch = foundUrl.match(/(https?:%2F%2F[^\\s\"'<>]+)/i);\n      if (nestedUrlMatch && nestedUrlMatch[1]) {\n        try {\n          foundUrl = decodeURIComponent(nestedUrlMatch[1]);\n        } catch (e) {}\n      }\n\n      outputItems.push({\n        json: {\n          hasPDF: true, \n          isLink: true, \n          pdfUrl: foundUrl,\n          subject: safeSubject\n        }\n      });\n    } else {\n      // 3. No attachment and no link found -> Send to AI Summarization path\n      outputItems.push({\n        json: {\n          hasPDF: false, \n          isLink: false,\n          emailBody: rawBody,\n          subject: safeSubject,\n        }\n      });\n    }\n  }\n}\n\nreturn outputItems;"
        },
