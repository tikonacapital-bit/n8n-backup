      "position": [
        320,
        496
      ],
      "credentials": {
        "n8nApi": {
          "id": "UHb21PeMpm4n6IMJ",
          "name": "n8n account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const zlib = require('zlib');\n\nreturn $input.all().map(item => {\n  const workflow = item.json;\n  const cleanName = (workflow.name || 'unnamed').replace(/[^a-zA-Z0-9_-]/g, '_');\n  const filePath = `workflows/${cleanName}_${workflow.id}.json.gz`;\n  \n  const jsonBuffer = Buffer.from(JSON.stringify(workflow, null, 2), 'utf-8');\n  const compressedBase64 = zlib.gzipSync(jsonBuffer).toString('base64');\n\n  return {\n    json: {\n      id: workflow.id,\n      name: workflow.name,\n      filePath: filePath,\n      content: compressedBase64\n    }\n  };\n});"
      },
      "id": "120cdd23-0b95-423f-9913-5e5c284e49cd",
      "name": "Compress & Format",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        528,
        496
      ]
    },
