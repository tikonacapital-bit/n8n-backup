    {
      "parameters": {
        "jsCode": "const webhookData = $('Webhook1').first().json.body;\nconst fileName = webhookData.file_name.toLowerCase();\n\n// Only apply filtering to annual reports\nif (!fileName.includes('annual') && !fileName.includes('ar_') && !fileName.includes('annual_report')) {\n  // Pass through non-AR documents unchanged\n  return $input.all();\n}\n\nconst fullText = $input.first().json.text || $input.first().json.data || '';\n\n// Define the sections we want to keep\nconst RELEVANT_SECTIONS = [\n  // Section markers commonly found in Indian annual reports\n  { start: /consolidated\\s+(financial\\s+)?statement/i, end: /standalone\\s+(financial\\s+)?statement|notes\\s+to\\s+.*financial/i, label: 'consolidated_financials' },\n  { start: /standalone\\s+(financial\\s+)?statement/i, end: /notes\\s+to\\s+.*financial|cash\\s+flow/i, label: 'standalone_financials' },\n  { start: /balance\\s+sheet|statement\\s+of\\s+financial\\s+position/i, end: /statement\\s+of\\s+profit|income\\s+statement/i, label: 'balance_sheet' },\n  { start: /cash\\s+flow\\s+statement|statement\\s+of\\s+cash\\s+flow/i, end: /notes\\s+to|significant\\s+accounting/i, label: 'cash_flow' },\n  { start: /management\\s+discussion|management('s)?\\s+discussion\\s+(&|and)\\s+analysis|md\\s*&\\s*a/i, end: /director('s)?\\s+report|corporate\\s+governance/i, label: 'mda' },\n  { start: /director('s)?\\s+report|board('s)?\\s+report/i, end: /corporate\\s+governance|auditor/i, label: 'directors_report' },\n  { start: /related\\s+party\\s+transaction/i, end: /additional\\s+information|other\\s+notes/i, label: 'related_party' },\n  { start: /auditor('s)?\\s+report|independent\\s+auditor/i, end: /annexure|financial\\s+statement/i, label: 'auditor_report' },\n  { start: /statement\\s+of\\s+profit\\s+(and|&)\\s+loss|income\\s+statement/i, end: /balance\\s+sheet|cash\\s+flow|notes/i, label: 'profit_loss' }\n];\n\n// Split into pages/sections (using form feeds or page markers)\nconst pages = fullText.split(/\\f|\\n{4,}|(?=\\n.*page\\s+\\d+)/i);\n\nconst relevantContent = [];\nlet currentSection = null;\nlet capturing = false;\n\nfor (const page of pages) {\n  const pageText = page.trim();\n  if (pageText.length < 50) continue;\n\n  // Check if this page starts a relevant section\n  for (const section of RELEVANT_SECTIONS) {\n    if (section.start.test(pageText)) {\n      currentSection = section.label;\n      capturing = true;\n      break;\n    }\n    if (capturing && section.end && section.end.test(pageText)) {\n      // We've hit the end marker of current section\n      relevantContent.push({\n        text: pageText,\n        section: currentSection\n      });\n      capturing = false;\n      currentSection = null;\n      break;\n    }\n  }\n\n  if (capturing) {\n    relevantContent.push({\n      text: pageText,\n      section: currentSection\n    });\n  }\n}\n\n// If regex-based extraction found very little, fall back to keyword density filtering\nif (relevantContent.length < 5) {\n  const HIGH_VALUE_KEYWORDS = [\n    'revenue', 'ebitda', 'profit', 'loss', 'margin', 'growth',\n    'cash flow', 'balance sheet', 'debt', 'equity', 'roe', 'roce',\n    'management discussion', 'director', 'auditor', 'related party',\n    'operating', 'capex', 'working capital', 'dividend',\n    'consolidated', 'standalone', 'segment', 'subsidiary'\n  ];\n\n  for (const page of pages) {\n    const lower = page.toLowerCase();\n    const keywordHits = HIGH_VALUE_KEYWORDS.filter(kw => lower.includes(kw)).length;\n    // Keep pages with 3+ financial keyword matches\n    if (keywordHits >= 3 && page.trim().length > 100) {\n      relevantContent.push({\n        text: page.trim(),\n        section: 'keyword_matched'\n      });\n    }\n  }\n}\n\n// Reconstruct as single text with section markers\nconst filteredText = relevantContent\n  .map(r => `[SECTION: ${r.section}]\\n${r.text}`)\n  .join('\\n\\n---\\n\\n');\n\nreturn [{\n  json: {\n    ...($input.first().json),\n    text: filteredText,\n    original_pages: pages.length,\n    filtered_sections: relevantContent.length,\n    is_filtered: true\n  }\n}];"
      },
