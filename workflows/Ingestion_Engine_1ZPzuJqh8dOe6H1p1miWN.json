          "jsCode": "const llmOutput = $input.first().json.output?.[0]?.content?.[0]?.text || $input.first().json.message?.content || $input.first().json.text || '';\nconst webhookData = $('Webhook').first().json.body;\n\nlet queries;\ntry {\n  // Strip markdown code blocks first\n  const cleaned = llmOutput.replace(/```json\\s*/g, '').replace(/```\\s*/g, '').trim();\n  const match = cleaned.match(/\\[[\\s\\S]*\\]/);\n  queries = match ? JSON.parse(match[0]) : [];\n} catch (e) {\n  queries = llmOutput.split('\\n').filter(q => q.trim().length > 5).slice(0, 5);\n}\n\nif (queries.length === 0) {\n  queries = [webhookData.searchKeywords.join(' ')];\n}\n\nreturn [{\n  json: {\n    queries: queries.slice(0, 5),\n    sessionId: webhookData.sessionId,\n    companyName: webhookData.companyName,\n    sectionPrompt: webhookData.sectionPrompt,\n    searchKeywords: webhookData.searchKeywords,\n    selectedDocIds: webhookData.selectedDocIds || [],\n    maxChunks: webhookData.maxChunks || 20\n  }\n}];"
