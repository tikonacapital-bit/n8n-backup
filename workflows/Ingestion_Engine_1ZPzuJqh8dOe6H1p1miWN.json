        "jsCode": "const webhookData = $('Webhook1').first().json.body;\nconst sessionId = webhookData.sessionId || webhookData.session_id;\nconst driveFileId = webhookData.driveFileId || webhookData.drive_file_id || webhookData.file_id;\nconst fileName = webhookData.fileName || webhookData.file_name;\n\nconst SUPABASE_URL = 'https://[REDACTED_USER]:[REDACTED_PASSWORD]@n8n/n8n-nodes-langchain.openAi",
