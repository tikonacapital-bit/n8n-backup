  "name": "Portfolio IRR Calculator",
  "active": true,
  "isArchived": false,
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "portfolio-holding-change",
        "options": {}
      },
      "id": "6f6eae2b-f32c-48c4-b908-cbc5db3a92bd",
      "name": "Supabase Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        -960,
        112
      ],
      "webhookId": "569070b2-3a7c-4b41-ae09-1bb78e7a4d3b"
    },
    {
      "parameters": {
        "jsCode": "// Supabase sends the payload in body\nconst payload = $input.first().json.body ?? $input.first().json;\n\n// INSERT uses 'record', DELETE uses 'old_record'\nconst record = payload.record ?? payload.old_record ?? {};\nconst portfolioId = record.portfolio_id;\n\nif (!portfolioId) {\n  throw new Error('No portfolio_id found. Payload: ' + JSON.stringify(payload));\n}\n\nreturn [{ json: { portfolio_id: portfolioId, event_type: payload.type } }];"
      },
      "id": "910dfde2-70cf-4f57-acee-05a7bfc9d52f",
      "name": "Extract portfolio_id",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -720,
        112
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://YOUR-PYTHON-API.railway.app/calculate",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "x-n8n-secret",
              "value": "YOUR_N8N_SECRET"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "portfolio_id",
              "value": "={{ $json.portfolio_id }}"
            }
          ]
        },
        "options": {
          "timeout": 60000
        }
      },
      "id": "cddccb2b-0823-45b9-af3a-5da6556dede0",
      "name": "Calculate IRR (Python API)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        -480,
        112
      ]
    },
    {
      "parameters": {
        "jsCode": "// Log the successful result\nconst data = $input.first().json;\nconsole.log('IRR calculated:', JSON.stringify(data));\nreturn [{ json: { done: true, portfolio_id: data.portfolio_id, irr: data.metrics?.portfolio_irr, alpha: data.metrics?.alpha } }];"
      },
      "id": "28403e31-5d1a-40f7-96af-c0ad3d14bf71",
      "name": "Log Success",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Log the error\nconst data = $input.first().json;\nconsole.error('IRR calculation failed or skipped:', JSON.stringify(data));\nreturn [{ json: { done: false, message: data.message ?? 'unknown error' } }];"
      },
      "id": "78184169-5db1-4ba4-8cf9-5b7b4eb7adab",
      "name": "Log Error / Skipped",
